<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 「下一节」组件要在上课那一刻精确切换：Android 12 用 SCHEDULE_EXACT_ALARM，
         13 起等效的 USE_EXACT_ALARM 安装即授予，无需用户手动开启 -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 重启后闹钟会丢失，需要重新排定切换点 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:name=".ScheduleApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Schedule">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ui.widget.NextClassWidgetReceiver"
            android:label="@string/widget_name_next_class"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_class_widget" />
        </receiver>

        <receiver
            android:name=".ui.widget.TodayWidgetReceiver"
            android:label="@string/widget_name_today"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget" />
        </receiver>

        <receiver
            android:name=".ui.widget.WeekWidgetReceiver"
            android:enabled="false"
            android:label="@string/widget_name_week"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget" />
        </receiver>

        <receiver
            android:name=".ui.widget.CountdownWidgetReceiver"
            android:label=""
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget" />
        </receiver>

        <receiver
            android:name=".ui.widget.WidgetRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.scnu.schedule.action.WIDGET_REFRESH" />
            </intent-filter>
        </receiver>

        <!-- 到点刷新「下一节」组件（每节课一次，不是每分钟） -->
        <receiver
            android:name=".ui.widget.NextClassTickReceiver"
            android:exported="false" />

        <!-- 开机后恢复切换闹钟 -->
        <receiver
            android:name=".ui.widget.BootRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
