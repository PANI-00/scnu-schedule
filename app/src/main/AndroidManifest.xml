<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 2×2 倒计时小组件：每分钟实时刷新所需的精确闹钟权限（Android 12+ 可在系统设置里授予/回收） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <application
        android:name=".ScheduleApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Schedule">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ui.widget.NextClassWidgetReceiver"
            android:label="@string/widget_name_next_class"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_class_widget" />
        </receiver>

        <receiver
            android:name=".ui.widget.TodayWidgetReceiver"
            android:label="@string/widget_name_today"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget" />
        </receiver>

        <receiver
            android:name=".ui.widget.WeekWidgetReceiver"
            android:enabled="false"
            android:label="@string/widget_name_week"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget" />
        </receiver>

        <receiver
            android:name=".ui.widget.CountdownWidgetReceiver"
            android:label=""
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget" />
        </receiver>

        <receiver
            android:name=".ui.widget.WidgetRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.scnu.schedule.action.WIDGET_REFRESH" />
            </intent-filter>
        </receiver>

        <!-- 每分钟触发倒计时小组件刷新的闹钟接收器 -->
        <receiver
            android:name=".ui.widget.CountdownTickReceiver"
            android:exported="false" />
    </application>
</manifest>
